# Written by `npx convex dev` (Next.js side)
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Set these in the Convex dashboard (Settings > Environment Variables), not here:
# APP_URL            https://studio.flmlnk.com   (used in email links)
# ADMIN_KEY          16+ random characters        (opens /admin)
# RESEND_API_KEY     re_...                        (without it, emails are logged as "skipped")
# EMAIL_FROM         FLMLNK Studio <studio@flmlnk.com>
# EMAIL_REPLY_TO     team@flmlnk.com               (optional)
# TEAM_ALERT_EMAIL   team@flmlnk.com               (hot-lead alerts)
# SLACK_WEBHOOK_URL  https://hooks.slack.com/...   (optional, hot-lead alerts)
